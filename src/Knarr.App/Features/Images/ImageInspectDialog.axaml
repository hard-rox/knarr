<common:DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:vm="using:Knarr.App.Features.Images"
                     xmlns:models="using:Knarr.Service.Models"
                     xmlns:common="using:Knarr.App.Common"
                     x:Class="Knarr.App.Features.Images.ImageInspectDialog"
                     x:DataType="vm:ImageInspectDialogViewModel"
                     Title="Inspect image"
                     Width="760" Height="600"
                     MinWidth="560" MinHeight="420"
                     WindowStartupLocation="CenterOwner"
                     ShowInTaskbar="False"
                     Background="{DynamicResource BackgroundBaseBrush}">

  <Design.DataContext>
    <vm:ImageInspectDialogViewModel />
  </Design.DataContext>

  <common:DialogWindow.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </common:DialogWindow.KeyBindings>

  <common:DialogWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Code,Consolas,monospace" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.none">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
    </Style>
  </common:DialogWindow.Styles>

  <Grid Margin="20" RowDefinitions="Auto,*" RowSpacing="14">

    <!-- Header: image reference only -->
    <SelectableTextBlock Grid.Row="0"
                         Text="{Binding ImageReference}"
                         FontSize="16" FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource TextBrush}" />

    <Panel Grid.Row="1">

      <!-- Loading -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                  IsVisible="{Binding IsLoading}">
        <ProgressBar Width="180" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" />
        <TextBlock Text="Inspecting image&#x2026;" HorizontalAlignment="Center"
                   FontSize="13" Foreground="{DynamicResource TextDimBrush}" />
      </StackPanel>

      <!-- Error -->
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                  MaxWidth="460" IsVisible="{Binding HasError}">
        <PathIcon Data="{StaticResource WarningRegular}" Width="24" Height="24"
                  Foreground="{DynamicResource TextDimBrush}" />
        <SelectableTextBlock Text="{Binding ErrorMessage}"
                             HorizontalAlignment="Center" TextAlignment="Center"
                             TextWrapping="Wrap" FontSize="13"
                             Foreground="{DynamicResource TextDimBrush}" />
        <Button Classes="accent" HorizontalAlignment="Center" Command="{Binding RefreshCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Data="{StaticResource ArrowClockwiseRegular}" Width="14" Height="14" />
            <TextBlock Text="Retry" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Content tabs -->
      <TabControl IsVisible="{Binding HasInspection}">

        <!-- Overview -->
        <TabItem Header="Overview">
          <ScrollViewer>
            <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="16" RowSpacing="12" Margin="4,8,12,8">

              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Repo tags" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value mono"
                                   Text="{Binding RepoTagsText}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Repo digests" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value mono" FontSize="11"
                                   Text="{Binding RepoDigestsText}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Image ID" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value mono" FontSize="11"
                                   Text="{Binding FullId}" />

              <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Architecture / OS" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                                   Text="{Binding Architecture, StringFormat='{}{0}'}"
                                   Foreground="{DynamicResource TextBrush}">
                <SelectableTextBlock.Text>
                  <MultiBinding StringFormat="{}{0} / {1}">
                    <Binding Path="Architecture" />
                    <Binding Path="OperatingSystem" />
                  </MultiBinding>
                </SelectableTextBlock.Text>
              </SelectableTextBlock>

              <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Size" />
              <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value mono"
                                   Text="{Binding SizeText}" />

              <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Created" />
              <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="value"
                                   Text="{Binding CreatedText}" />

              <TextBlock Grid.Row="6" Grid.Column="0" Classes="label" Text="Author" />
              <SelectableTextBlock Grid.Row="6" Grid.Column="1" Classes="value"
                                   Text="{Binding AuthorText}" />

              <TextBlock Grid.Row="7" Grid.Column="0" Classes="label" Text="Comment" />
              <SelectableTextBlock Grid.Row="7" Grid.Column="1" Classes="value"
                                   Text="{Binding CommentText}" />
            </Grid>
          </ScrollViewer>
        </TabItem>

        <!-- Configuration -->
        <TabItem Header="Configuration">
          <ScrollViewer>
            <StackPanel Spacing="18" Margin="4,8,12,8">

              <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="16" RowSpacing="12">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Entrypoint" />
                <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value mono"
                                     Text="{Binding EntrypointText}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Command" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value mono"
                                     Text="{Binding CommandText}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Working directory" />
                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value mono"
                                     Text="{Binding WorkingDirectoryText}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="User" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value"
                                     Text="{Binding UserText}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Stop signal" />
                <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value"
                                     Text="{Binding StopSignalText}" />
              </Grid>

              <!-- Exposed ports -->
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Exposed ports" />
                <TextBlock Classes="none" Text="None" IsVisible="{Binding !HasExposedPorts}" />
                <ItemsControl ItemsSource="{Binding ExposedPorts}" IsVisible="{Binding HasExposedPorts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="glass-panel" CornerRadius="999" Margin="0,0,6,6" Padding="10,4">
                        <SelectableTextBlock Classes="mono" FontSize="12"
                                             Foreground="{DynamicResource TextBrush}" Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Volumes -->
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Volumes" />
                <TextBlock Classes="none" Text="None" IsVisible="{Binding !HasVolumes}" />
                <ItemsControl ItemsSource="{Binding Volumes}" IsVisible="{Binding HasVolumes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <SelectableTextBlock Classes="value mono" Margin="0,0,0,4" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Environment variables -->
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Environment" />
                <TextBlock Classes="none" Text="None" IsVisible="{Binding !HasEnvironmentVariables}" />
                <ItemsControl ItemsSource="{Binding EnvironmentVariables}"
                              IsVisible="{Binding HasEnvironmentVariables}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:InspectionEntry">
                      <Grid ColumnDefinitions="200,*" ColumnSpacing="12" Margin="0,0,0,4">
                        <SelectableTextBlock Grid.Column="0" Classes="value mono" FontSize="12"
                                             Text="{Binding Key}" />
                        <SelectableTextBlock Grid.Column="1" Classes="value mono" FontSize="12"
                                             Foreground="{DynamicResource TextDimBrush}"
                                             Text="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Labels -->
              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Labels" />
                <TextBlock Classes="none" Text="None" IsVisible="{Binding !HasLabels}" />
                <ItemsControl ItemsSource="{Binding Labels}" IsVisible="{Binding HasLabels}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:InspectionEntry">
                      <Grid ColumnDefinitions="200,*" ColumnSpacing="12" Margin="0,0,0,4">
                        <SelectableTextBlock Grid.Column="0" Classes="value mono" FontSize="12"
                                             Text="{Binding Key}" />
                        <SelectableTextBlock Grid.Column="1" Classes="value" FontSize="12"
                                             Foreground="{DynamicResource TextDimBrush}"
                                             Text="{Binding Value}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- Raw JSON -->
        <TabItem Header="Raw JSON">
          <Border Classes="glass-panel" CornerRadius="12" ClipToBounds="True" Margin="0,4,0,0">
            <ScrollViewer Padding="12" HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Classes="mono" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding RawJson}" />
            </ScrollViewer>
          </Border>
        </TabItem>
      </TabControl>
    </Panel>
  </Grid>
</common:DialogWindow>
