<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX Toolset v4 source file for the Knarr Windows installer (MSI).

  Built by the CD workflow (.github/workflows/cd.yml) via:
    wix build ./Setup.wxs -arch x64 -d PublishDir="<path to publish/portable>" -o Knarr-win-x64.msi

  PublishDir must point at the `dotnet publish -r win-x64 --self-contained true`
  output folder (default: ./publish/portable). Knarr.App.exe is renamed to
  Knarr.exe in the install folder and Start Menu shortcut; every other file
  produced by the self-contained publish is harvested automatically via the
  <Files> element below.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Knarr"
           Manufacturer="Knarr"
           Version="1.0.0.0"
           UpgradeCode="6f2d6a0b-6b3b-4a9a-9f1a-6a2c9b1c9a11"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="KnarrIcon.exe" SourceFile="$(var.PublishDir)\Knarr.App.exe" />
    <Property Id="ARPPRODUCTICON" Value="KnarrIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Knarr">
        <!-- Main executable, renamed from Knarr.App.exe to Knarr.exe -->
        <Component Id="MainExecutable" Guid="7c8e5b0a-9d0c-4b6a-8a2b-1f6b8f3e2c01">
          <File Id="KnarrExe"
                Source="$(var.PublishDir)\Knarr.App.exe"
                Name="Knarr.exe"
                KeyPath="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="Knarr"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="KnarrIcon.exe"
                      Advertise="yes" />
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="Knarr"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="KnarrIcon.exe"
                      Advertise="yes" />
          </File>
        </Component>

        <!--
          Harvest every remaining self-contained publish output (runtime, native
          libs, dependent assemblies, etc.) except the renamed main executable.
        -->
        <Files Include="$(var.PublishDir)\**"
               Exclude="$(var.PublishDir)\Knarr.App.exe" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="Knarr" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>
